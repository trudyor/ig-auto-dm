# 이 파일을 복사해서 ".env" 라는 이름으로 저장하고 값을 채우세요.

# 웹훅 검증용 - 아무 비밀 문자열이나 직접 정하면 됩니다 (Meta 설정 때 똑같이 입력)
VERIFY_TOKEN=my-secret-token-1234

# Meta 앱 시크릿 (개발자 대시보드 > 앱 설정 > 기본 설정)
APP_SECRET=여기에_앱_시크릿

# 인스타 비즈니스 계정 액세스 토큰 (Graph API Explorer에서 발급)
IG_ACCESS_TOKEN=여기에_액세스_토큰

# 내 인스타 비즈니스 계정 ID (숫자)
IG_BUSINESS_ID=여기에_계정_ID

# (선택) 서버 포트
PORT=3000
